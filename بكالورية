    <script>
        // التنقل بين المواد
        function switchTab(event, subjectId) {
            document.querySelectorAll('.subject-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById(subjectId).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        // تبديل حالة الدرس
        function toggleLesson(button) {
            const item = button.closest('.lesson-item');
            const badge = item.querySelector('.status-badge');
            
            item.classList.toggle('is-done');
            
            if (item.classList.contains('is-done')) {
                badge.textContent = 'تم الإنجاز ✔';
                badge.className = 'status-badge completed';
                button.textContent = 'إلغاء الإتمام ❌';
            } else {
                badge.textContent = 'متراكم';
                badge.className = 'status-badge accumulated';
                button.textContent = 'إتمام الدرس ✔';
            }
            saveProgress();
            updateProgress();
        }

        // حساب وتحديث نسب الإنجاز
        function updateProgress() {
            const subjects = ['arabic', 'english', 'history', 'programming'];
            let totalLessons = 0;
            let totalDone = 0;

            subjects.forEach(sub => {
                const subContainer = document.getElementById(sub);
                const lessons = subContainer.querySelectorAll('.lesson-item');
                const doneLessons = subContainer.querySelectorAll('.lesson-item.is-done');
                
                const percent = lessons.length > 0 ? Math.round((doneLessons.length / lessons.length) * 100) : 0;
                document.getElementById(`${sub}-percent`).textContent = `${percent}%`;

                totalLessons += lessons.length;
                totalDone += doneLessons.length;
            });

            const overallPercent = totalLessons > 0 ? Math.round((totalDone / totalLessons) * 100) : 0;
            document.getElementById('overall-text').textContent = `${overallPercent}% (${totalDone}/${totalLessons} درس)`;
            document.getElementById('overall-bar').style.width = `${overallPercent}%`;
        }

        // حفظ الحالة في LocalStorage
        function saveProgress() {
            const data = {};
            document.querySelectorAll('.lesson-item').forEach((item, index) => {
                data[index] = item.classList.contains('is-done');
            });
            localStorage.setItem('study_progress_malek', JSON.stringify(data));
        }

        // استرجاع الحالة عند فتح الصفحة
        function loadProgress() {
            const saved = localStorage.getItem('study_progress_malek');
            if (saved) {
                try {
                    const data = JSON.parse(saved);
                    document.querySelectorAll('.lesson-item').forEach((item, index) => {
                        if (data[index]) {
                            item.classList.add('is-done');
                            const badge = item.querySelector('.status-badge');
                            const button = item.querySelector('.done-btn');
                            if (badge) {
                                badge.textContent = 'تم الإنجاز ✔';
                                badge.className = 'status-badge completed';
                            }
                            if (button) {
                                button.textContent = 'إلغاء الإتمام ❌';
                            }
                        }
                    });
                } catch (e) {
                    console.error("Error loading progress:", e);
                }
            }
            updateProgress();
        }

        window.onload = loadProgress;
    </script>
