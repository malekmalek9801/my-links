<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة المتابعة الدراسية - MZ</title>
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --primary-color: #8b0000; /* أحمر غامق فاخر */
            --primary-hover: #a30000;
            --text-main: #ffffff;
            --text-muted: #b0b0b0;
            --accent-green: #2e7d32;
            --accent-red: #c62828;
            --yt-red: #ff0000;
            --border-color: #333333;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            padding: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 25px;
            padding: 20px;
            background: var(--card-bg);
            border-radius: 12px;
            border-bottom: 4px solid var(--primary-color);
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        header h1 {
            color: var(--text-main);
            font-size: 2rem;
            margin-bottom: 5px;
        }

        header p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* شريط نسبة الإنجاز الإجمالية */
        .overall-progress {
            background: var(--card-bg);
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 25px;
            border: 1px solid var(--border-color);
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .progress-bar-bg {
            background: #2a2a2a;
            height: 12px;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid #444;
        }

        .progress-bar-fill {
            background: linear-gradient(90deg, var(--primary-color), #d32f2f, #2e7d32);
            height: 100%;
            width: 0%;
            transition: width 0.4s ease;
        }

        /* شريط التنقل بين المواد */
        .tabs {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background-color: var(--card-bg);
            color: var(--text-main);
            border: 2px solid var(--border-color);
            padding: 12px 22px;
            font-size: 1.05rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            border-color: var(--primary-color);
        }

        .tab-btn.active {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            box-shadow: 0 0 15px rgba(139, 0, 0, 0.4);
        }

        /* محتوى المواد */
        .subject-content {
            display: none;
            background-color: var(--card-bg);
            padding: 25px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .subject-content.active {
            display: block;
            animation: fadeIn 0.4s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2.subject-title {
            color: var(--primary-color);
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 10px;
            margin-bottom: 20px;
            font-size: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .subject-percent {
            font-size: 1rem;
            background: #2a2a2a;
            padding: 4px 12px;
            border-radius: 20px;
            color: #fff;
            border: 1px solid var(--border-color);
        }

        .concept-title {
            color: #ff5252;
            font-size: 1.25rem;
            margin-top: 20px;
            margin-bottom: 12px;
            border-bottom: 1px solid #444;
            padding-bottom: 5px;
        }

        .section-group {
            margin-bottom: 20px;
        }

        .section-group h3 {
            color: #e0e0e0;
            font-size: 1.1rem;
            margin-bottom: 10px;
            background: #252525;
            padding: 8px 12px;
            border-right: 4px solid var(--primary-color);
            border-radius: 4px;
        }

        .section-group h4 {
            color: #ff8a80;
            font-size: 0.95rem;
            margin: 10px 0 6px 0;
        }

        .lessons-list {
            list-style: none;
        }

        .lesson-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #2a2a2a;
            padding: 12px 15px;
            margin-bottom: 8px;
            border-radius: 6px;
            transition: background 0.2s;
            gap: 15px;
            flex-wrap: wrap;
        }

        .lesson-item:hover {
            background: #333333;
        }

        .lesson-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
            min-width: 250px;
        }

        .lesson-name {
            font-size: 0.98rem;
            font-weight: 500;
        }

        .status-badge {
            font-size: 0.8rem;
            font-weight: bold;
            padding: 2px 8px;
            border-radius: 4px;
            width: fit-content;
        }

        .status-badge.accumulated {
            background-color: rgba(198, 40, 40, 0.2);
            color: #ff5252;
            border: 1px solid var(--accent-red);
        }

        .status-badge.completed {
            background-color: rgba(46, 125, 50, 0.2);
            color: #69f0ae;
            border: 1px solid var(--accent-green);
        }

        .actions-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* زر يوتيوب */
        .yt-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background-color: #272727;
            color: #ffffff;
            border: 1px solid #444;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: bold;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .yt-btn:hover {
            background-color: var(--yt-red);
            border-color: var(--yt-red);
            color: #fff;
            box-shadow: 0 0 10px rgba(255, 0, 0, 0.4);
        }

        /* زر الإنجاز */
        .done-btn {
            background-color: #3b3b3b;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

        .done-btn:hover {
            background-color: #505050;
        }

        .lesson-item.is-done .done-btn {
            background-color: var(--accent-green);
        }

        @media (max-width: 768px) {
            .tabs {
                flex-direction: column;
            }
            .tab-btn {
                width: 100%;
                text-align: center;
            }
            .lesson-item {
                flex-direction: column;
                align-items: flex-start;
            }
            .actions-group {
                width: 100%;
                justify-content: space-between;
            }
        }
    </style>
</head>
